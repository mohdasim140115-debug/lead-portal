# ---- Core ----
MONGODB_URI=mongodb://127.0.0.1:27017/lead_portal
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Auth ----
# 32+ char random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_NAME=lp_session
# Session lifetime in seconds (default 7 days)
AUTH_SESSION_TTL=604800

# ---- Seed (first Super Admin) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ADMIN_NAME=Super Admin

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Meta Lead Ads ----
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ---- Google Ads Lead Form ----
GOOGLE_LEAD_WEBHOOK_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Landing page / external lead ingestion ----
# Comma-separated API keys accepted by POST /api/leads (public capture)
LEAD_INGEST_API_KEYS=
